#!/bin/sh
# nosuid,nodev,noexec everywhere they are safe. /dev keeps device nodes (no
# nodev) but drops suid+exec. these close the one W^X hole in an otherwise
# immutable system: a static-pie binary needs no loader, so a writable+
# executable tmpfs was a place to drop and run code. noexec /tmp shuts it.
mount -t proc  -o nosuid,nodev,noexec none /proc
mount -t sysfs -o nosuid,nodev,noexec none /sys
mount -t devtmpfs -o nosuid,noexec none /dev 2>/dev/null
# securityfs exposes /sys/kernel/security/lockdown so the lockdown state is
# provable at runtime (the test block reads it; A8 asserts it).
mount -t securityfs -o nosuid,nodev,noexec none /sys/kernel/security 2>/dev/null

# ptys. devtmpfs does not create /dev/pts, and without it openpty() fails --
# which means no multiplexer and no ssh session can allocate a terminal. nothing
# in the image used a pty until now, which is why this was missing and nothing
# noticed. ptmxmode=666 so an unprivileged process could open it the day
# anything here stops running as root.
mkdir -p /dev/pts
mount -t devpts -o nosuid,noexec,gid=5,mode=620,ptmxmode=666 none /dev/pts 2>/dev/null

# the root is read-only by design, so anything that needs to write gets a
# RAM-backed home. nothing here survives a reboot, which is the point.
mount -t tmpfs -o nosuid,nodev,noexec none /tmp

# runtime sysctl hardening. write /proc/sys directly (no sysctl-applet dep).
# a key whose feature is compiled out is simply absent -- that is already the
# safe state, so skip it; a write that FAILS on a present key is loud. several
# (dmesg_restrict, perf_event_paranoid) are inert while the console is root,
# and are set for the day that stops being true.
for kv in \
  kernel/kptr_restrict=2 \
  kernel/dmesg_restrict=1 \
  kernel/perf_event_paranoid=3 \
  fs/protected_symlinks=1 \
  fs/protected_hardlinks=1 \
  fs/protected_fifos=2 \
  fs/protected_regular=2 \
  net/ipv4/tcp_syncookies=1 \
  net/ipv4/conf/all/accept_redirects=0 \
  net/ipv4/conf/all/send_redirects=0 \
  net/ipv4/conf/all/accept_source_route=0 \
  net/ipv4/conf/all/rp_filter=1 \
  net/ipv4/icmp_echo_ignore_broadcasts=1
do
  p=/proc/sys/${kv%=*}; v=${kv#*=}
  [ -e "$p" ] || continue
  echo "$v" > "$p" 2>/dev/null || echo "sysctl FAILED: ${kv%=*}"
done
# /run is a symlink into the tmpfs. cryptsetup keeps its device locks under
# /run/cryptsetup and aborts rather than proceeding without them.
mkdir -p /tmp/run/cryptsetup
# clock floor. no RTC is compiled in, so the system clock is whatever the
# firmware left -- correct by luck under a good BIOS, epoch 0 under a dead CMOS
# battery, and attacker-controlled on a hostile network with no signed source.
# TLS cert validation reads this clock (BearSSL falls back to it), so a clock
# set backwards makes revoked and expired certs validate again. xos.epoch is
# the build date, pinned inside the signed UKI where it cannot be forged. never
# go below it: max(clock, floor). this does not make the clock RIGHT, it makes
# it impossible to push into the past, which is the property TLS needs.
epoch=$(sed -n 's/.*xos\.epoch=\([0-9][0-9]*\).*/\1/p' /proc/cmdline)
if [ -n "$epoch" ]; then
	now=$(date -u +%s 2>/dev/null || echo 0)
	if [ "$now" -lt "$epoch" ]; then date -u -s "@$epoch" >/dev/null 2>&1 || echo "clock floor FAILED: could not set clock to epoch $epoch"; fi
fi

# boot fingerprint: four words derived from the verity roothash on the SIGNED
# cmdline. a tampered image panics before it can speak, so these cannot lie;
# what they catch is a DIFFERENT validly-signed image -- an old release, a
# swapped stick -- whose roothash necessarily differs, so its words differ.
# memorize yours; they change only when the image is re-pinned.
fpw=""
fprh=$(sed -n 's/.*sha256 \([0-9a-f]\{64\}\).*/\1/p' /proc/cmdline | head -1)
if [ -n "$fprh" ] && [ -f /usr/share/xos/words ]; then
	i=1
	while [ "$i" -le 8 ]; do
		b=$(printf %s "$fprh" | cut -c"$i"-"$((i+1))")
		w=$(sed -n "$((0x$b + 1))p" /usr/share/xos/words)
		[ -n "$w" ] || { fpw=""; break; }
		fpw="$fpw$w "
		i=$((i+2))
	done
	fpw="${fpw% }"
fi
[ -n "$fpw" ] || echo "fingerprint FAILED: no roothash or bad wordlist"

# dead-man tether: the root is a RAM copy, so pulling the stick otherwise
# changes nothing. if the device backing dm-0 sits on the usb bus, watch it;
# the moment it vanishes, power off -- nothing to flush, nothing to save,
# that is the amnesic contract. the arming test is "is the backing device on
# usb", not a flag, so virtio boots (qemu rigs) are never armed.
XOS_TETHER="no (not usb)"
tslave=$(ls /sys/block/dm-0/slaves 2>/dev/null | head -1)
if grep -q xos.notether /proc/cmdline; then
	XOS_TETHER="off (xos.notether)"
elif [ -n "$tslave" ]; then
	case "$(realpath "/sys/class/block/$tslave" 2>/dev/null)" in
	*/usb*)
		XOS_TETHER=yes
		(
			while [ -e "/sys/class/block/$tslave" ]; do sleep 2; done
			echo "xos: boot stick removed -- powering off" > /dev/console
			poweroff -f
		) &
		;;
	esac
fi

mkdir -p /tmp/home
export HOME=/tmp/home
export XDG_DATA_HOME=/tmp/home/.local/share
export XDG_CONFIG_HOME=/tmp/home/.config
export XDG_STATE_HOME=/tmp/home/.local/state
export TERM=linux
# ENV points every interactive ash at an rc file. that is how vi editing
# becomes the DEFAULT -- you never type `set -o vi`; the shell is already in it.
export ENV=/etc/shrc
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_STATE_HOME"

ip link set lo up 2>/dev/null
# per-boot mac: a stick that never leaves a stable hardware address on the
# networks it visits. locally-administered (bit 2 set) + unicast (bit 1
# clear), drawn from a pool the signed cmdline already vouches for
# (random.trust_cpu=1). xos.realmac opts back into the burned-in address for
# mac-allowlisted networks; flipping it costs a re-sign, same as any knob.
randmac() {
	# shellcheck disable=SC2046
	set -- $(od -An -N6 -tu1 /dev/urandom)
	printf '%02x:%02x:%02x:%02x:%02x:%02x' \
		"$(( ($1 | 2) & 254 ))" "$2" "$3" "$4" "$5" "$6"
}
if ! grep -q xos.nonet /proc/cmdline; then
	# pci nics are up before /init; usb net (tether/dongle) enumerates on
	# xhci a second or two later. one pass misses it -- re-scan until a lease
	# lands or the deadline passes. wired boxes exit on pass 1; only a box
	# that needs the usb uplink waits, and it is bounded so we never hang.
	t=0
	while : ; do
		# busybox ls is the idiom for iterating /sys/class/net here
		# shellcheck disable=SC2045
		for dev in $(ls /sys/class/net 2>/dev/null); do
			[ "$dev" = lo ] && continue
			# randomize once per iface per boot, while the link is still
			# down. failure is loud but not fatal: the iface comes up on
			# its hardware mac (degraded privacy, not a dead network) and
			# the mac-randomized probe makes it visible.
			if ! grep -q xos.realmac /proc/cmdline && [ ! -f "/tmp/mac.$dev" ]; then
				cat "/sys/class/net/$dev/address" > "/tmp/mac.$dev" 2>/dev/null
				ip link set dev "$dev" address "$(randmac)" 2>/dev/null \
					|| echo "mac randomization FAILED: $dev"
			fi
			ip link set "$dev" up 2>/dev/null
			[ "$(cat /sys/class/net/"$dev"/carrier 2>/dev/null)" = 1 ] || continue
			udhcpc -i "$dev" -q -t 3 -T 1 >/dev/null 2>&1 && break 2
		done
		t=$((t+1)); [ "$t" -ge 6 ] && break
		sleep 1
	done
fi

# ── recon: know the machine you plugged into ────────────────────────────────
#
# a stick that travels meets many machines, and the evil-maid problem is not
# only about the stick -- the MACHINE can change under you: a bios reflash, a
# new pci card, an implant on the usb bus. the kernel already knows all of it;
# this writes that knowledge down, one file per machine on the encrypted
# state partition, and prints what changed since the last visit. no state
# unlocked, no recon -- an attacker holding the stick learns nothing about
# where it has been.
recon_inv() {
	local f p
	for f in sys_vendor product_name product_version board_name bios_vendor bios_version bios_date; do
		# strip control chars: a firmware-supplied DMI string is untrusted, and
		# an embedded newline would inject a spoofed record into this line-oriented
		# inventory (and the identity hash derived from it).
		[ -r "/sys/class/dmi/id/$f" ] && printf 'dmi %s %s\n' "$f" "$(tr -cd '[:print:]' < "/sys/class/dmi/id/$f")"
	done
	for p in /sys/bus/pci/devices/*; do
		[ -r "$p/vendor" ] && printf 'pci %s %s %s\n' "${p##*/}" "$(cat "$p/vendor")" "$(cat "$p/device")"
	done
	for p in /sys/bus/usb/devices/*; do
		[ -r "$p/idVendor" ] && printf 'usb %s %s:%s\n' "${p##*/}" "$(cat "$p/idVendor")" "$(cat "$p/idProduct")"
	done
	sed -n 's/^model name[^:]*: /cpu /p' /proc/cpuinfo | sort -u
	printf 'cpus %s\n' "$(nproc)"
}
recon_check() { # $1 = root of the unlocked state filesystem
	local dir="$1/recon" now=/tmp/recon.now mid old
	recon_inv > "$now" 2>/dev/null
	if ! [ -s "$now" ]; then
		printf '  recon FAILED: empty inventory\n' > /dev/console; rm -f "$now"; return
	fi
	# machine identity = the dmi block; a machine with no dmi at all falls
	# back to its cpu lines rather than colliding every such machine into
	# the hash of nothing.
	if grep -q '^dmi ' "$now"; then mid=$(grep '^dmi ' "$now" | sha256sum | cut -c1-16)
	else mid=$(grep '^cpu' "$now" | sha256sum | cut -c1-16); fi
	old="$dir/$mid"
	if [ ! -f "$old" ]; then
		printf '  recon: first visit to machine %s -- baseline recorded\n' "$mid" > /dev/console
	elif cmp -s "$old" "$now"; then
		printf '  recon: machine %s is as you left it\n' "$mid" > /dev/console
	else
		printf '  recon: MACHINE %s CHANGED since your last visit:\n' "$mid" > /dev/console
		diff "$old" "$now" | sed -n 's/^-\([^-]\)/    gone: \1/p;s/^+\([^+]\)/    new:  \1/p' > /dev/console
	fi
	{ mkdir -p "$dir" && cp "$now" "$old" && sync; } 2>/dev/null \
		|| printf '  recon FAILED: could not record the baseline\n' > /dev/console
	rm -f "$now"
}

if grep -q xos.test /proc/cmdline; then
	echo
	echo "XOS-TEST-BEGIN"
	# no kernel message may split a probe line: the harness greps for exact
	# strings, and an interleaved printk was corrupting a different probe every
	# run. dmesg still works (this only quiets async console printing).
	_prevprintk=$(cat /proc/sys/kernel/printk 2>/dev/null | awk '{print $1}')
	echo 0 > /proc/sys/kernel/printk 2>/dev/null
	printf 'rootfs-type: '; awk '$2=="/" {print $3}' /proc/mounts
	printf 'rootfs-flags: '; awk '$2=="/" {print $4}' /proc/mounts
	printf 'write-to-root: '; if touch /probe 2>/dev/null; then echo "SUCCEEDED (BAD)"; else echo "refused (good)"; fi
	printf 'dynamic-loader-present: '; if [ -e /lib/ld-musl-x86_64.so.1 ]; then echo "yes (BAD)"; else echo "no (good)"; fi
	printf 'module-loader: '; if [ -e /proc/modules ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	# kernel attack-surface + containment probes (A8/A9 grep these)
	printf 'devmem-node: '; if [ -e /dev/mem ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	printf 'devport-node: '; if [ -e /dev/port ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	printf 'kcore: '; if [ -e /proc/kcore ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	printf 'kexec-loaded: '; if [ -e /sys/kernel/kexec_loaded ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	printf 'vsyscall-map: '; _c=$(grep -c vsyscall /proc/self/maps 2>/dev/null); echo "${_c:-0}"
	printf 'lockdown: '; cat /sys/kernel/security/lockdown 2>/dev/null || echo "(no securityfs)"
	printf 'remount-rw: '; if mount -o remount,rw / 2>/dev/null; then echo "SUCCEEDED (BAD)"; else echo "refused (good)"; fi
	printf 'tmp-exec: '; cp /bin/busybox /tmp/probe-x 2>/dev/null; chmod +x /tmp/probe-x 2>/dev/null; if /tmp/probe-x true 2>/dev/null; then echo "SUCCEEDED (BAD)"; else echo "refused (good)"; fi; rm -f /tmp/probe-x
	printf 'kptr-restrict: '; cat /proc/sys/kernel/kptr_restrict 2>/dev/null || echo '?'
	printf 'dmesg-restrict: '; cat /proc/sys/kernel/dmesg_restrict 2>/dev/null || echo '?'
	# both heap paths zeroed: alloc (INIT_ON_ALLOC) and free (INIT_ON_FREE).
	# probes run as root, so dmesg_restrict does not bite here.
	printf 'mem-autoinit: '; dmesg | grep -o 'heap alloc:on, heap free:on' | head -1 | grep . || echo "MISSING (BAD)"
	printf 'busybox-runs: '; busybox true && echo yes || echo no
	printf 'shell-vi-default: '; ENV=/etc/shrc printf 'set +o\n' | ENV=/etc/shrc /bin/sh -i 2>&1 | grep -q 'o vi' && echo yes || echo "no (BAD)"
	printf 'no-bash: '; if [ -e /bin/bash ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	# a pty is the thing every multiplexer and every ssh session needs. prove one
	# can actually be allocated, not merely that the config claims to allow it.
	printf 'devpts-mounted: '; awk '$2=="/dev/pts" {print $3; f=1} END{if(!f) print "no"}' /proc/mounts
	printf 'ptmx-node: '; if [ -c /dev/ptmx ]; then echo yes; else echo "no (BAD)"; fi
	printf 'pty-alloc: '; if exec 9<>/dev/ptmx 2>/dev/null; then
		_slave=no
		for _p in /dev/pts/[0-9]*; do [ -e "$_p" ] && _slave=yes && break; done
		[ "$_slave" = yes ] && echo ok || echo "FAILED (no slave)"
		exec 9>&-
	else echo "FAILED (no ptmx)"; fi
	printf 'legacy-ptys: '; if [ -c /dev/ptyp0 ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	# the strongest end-to-end statement this system can make about itself:
	# the bytes actually mounted, hashed, so they can be compared against the
	# digest recorded when the image was built. note the comparison value must
	# come from OUTSIDE -- a checksum stored inside the thing it describes
	# proves nothing, which is exactly why the root hash lives on the signed
	# kernel command line and not in the filesystem.
	printf 'rootfs-digest: '; sha256sum /dev/dm-0 2>/dev/null | cut -d' ' -f1 | grep . || echo none
	printf 'verity-roothash: '; sed -n 's/.*sha256 \([0-9a-f]\{64\}\).*/\1/p' /proc/cmdline | head -1
	printf 'fingerprint: %s\n' "${fpw:-MISSING (BAD)}"
	printf 'tether-armed: %s\n' "$XOS_TETHER"
	printf 'verity-onerror: '; grep -o 'panic_on_corruption' /proc/cmdline | head -1 | grep . || echo none
	# p3 depends on all of these existing in the kernel. assert them rather than
	# trusting the config, the same way every other claim here is asserted.
	printf 'fs-ext4: '; grep -qw ext4 /proc/filesystems && echo yes || echo "no (BAD)"
	printf 'fs-vfat: '; grep -qw vfat /proc/filesystems && echo yes || echo "no (BAD)"
	printf 'fs-exfat: '; grep -qw exfat /proc/filesystems && echo yes || echo "no (BAD)"
	printf 'fs-iso9660: '; grep -qw iso9660 /proc/filesystems && echo yes || echo "no (BAD)"
	printf 'fs-ntfs3: '; grep -qw ntfs3 /proc/filesystems && echo yes || echo "no (BAD)"
	# /proc/crypto lists INSTANTIATED algorithms. xts and hmac are templates and
	# do not appear until something asks for xts(aes) or hmac(sha512), so their
	# absence here means nothing -- G14 asserts them from the built config
	# instead. what is worth probing is the concrete ciphers they build on.
	printf 'clock-floor: '; sed -n 's/.*xos\.epoch=\([0-9]*\).*/\1/p' /proc/cmdline | head -1 | grep . || echo "not pinned (BAD)"
	printf 'clock-not-before-floor: '; nowchk=$(date -u +%s); floorchk=$(sed -n 's/.*xos\.epoch=\([0-9]*\).*/\1/p' /proc/cmdline | head -1); [ "${nowchk:-0}" -ge "${floorchk:-0}" ] && echo yes || echo "no (BAD)"
	printf 'entropy-trusted: '; grep -o 'random.trust_cpu=1' /proc/cmdline | head -1 | grep . || echo "not pinned (BAD)"
	printf 'crypto-aes: '; grep -qw aes /proc/crypto && echo yes || echo "no (BAD)"
	printf 'crypto-sha512: '; grep -qw sha512 /proc/crypto && echo yes || echo "no (BAD)"
	# the whole p3 stack, exercised rather than assumed: cryptsetup binary,
	# dm-crypt, dm-integrity and the kernel crypto backend. a 24 MiB scratch
	# file in tmpfs stands in for the partition. --pbkdf pbkdf2 because argon2
	# would spend seconds grinding memory for a throwaway test.
	printf 'flock-works: '; if flock -x /tmp/lk true 2>/dev/null; then echo yes; else echo "no (BAD)"; fi
	printf 'cryptsetup-runs: '; cryptsetup --version 2>&1 | head -1 | grep -q KERNEL_CAPI && echo yes || echo "no (BAD)"
	dd if=/dev/zero of=/tmp/p3.img bs=1M count=64 2>/dev/null
	printf 'loop-node: '; [ -b /dev/loop0 ] && echo present || echo "absent (BAD)"
	printf 'dm-control: '; [ -c /dev/mapper/control ] && echo present || echo "absent (BAD)"
	printf 'losetup: '; losetup /dev/loop0 /tmp/p3.img 2>&1 | head -1 | grep . || echo ok
	printf 'luks-format: '
	if printf 'testpass' | cryptsetup luksFormat --type luks2 --integrity hmac-sha256 \
	     --pbkdf pbkdf2 --pbkdf-force-iterations 1000 --integrity-no-wipe --batch-mode --key-file - /dev/loop0 >/tmp/cs.log 2>&1
	then echo ok; else printf 'FAILED -- '; head -2 /tmp/cs.log | tr '\n' ' '; echo; fi
	printf 'luks-open: '
	if printf 'testpass' | cryptsetup open --key-file - /dev/loop0 p3test >/tmp/cso.log 2>&1
	then echo ok; else printf 'FAILED -- '; head -2 /tmp/cso.log | tr '\n' ' '; echo; fi
	printf 'luks-integrity-active: '
	cryptsetup status p3test 2>/dev/null | grep -o 'integrity:.*' | head -1 || echo none
	printf 'luks-wrong-pass-refused: '
	if printf 'wrongpass' | cryptsetup open --key-file - /dev/loop0 p3bad >/dev/null 2>&1
	then echo "ACCEPTED (BAD)"; else echo "refused (good)"; fi
	cryptsetup close p3test >/dev/null 2>&1
	losetup -d /dev/loop0 2>/dev/null; rm -f /tmp/p3.img
	printf 'abduco-runs: '; abduco 2>&1 | head -1 | grep -q 'Active sessions' && echo yes || echo no
	# the property that matters is not "abduco starts" but "the program outlives
	# the thing that started it". start a counter detached, wait, and read the
	# session back: if the session is still listed, nothing owned it but abduco.
	abduco -n probe /bin/sh -c 'i=0; while [ $i -lt 20 ]; do echo $i > /tmp/tick; i=$((i+1)); sleep 1; done' >/dev/null 2>&1
	sleep 3
	printf 'abduco-session-listed: '; abduco 2>&1 | grep -q probe && echo yes || echo no
	printf 'abduco-child-alive: '; [ -s /tmp/tick ] && echo yes || echo no
	# learn must describe the system that is actually running, not the one it was
	# written against -- A15 reads these two back.
	printf 'learn-refs: '; _n=0; for _f in /usr/share/learn/ref/*; do [ -e "$_f" ] && _n=$((_n+1)); done; echo "$_n"
	printf 'learn-runs: '; _c=$(learn list 2>/dev/null | grep -c .); echo "${_c:-0}"
	printf 'learn-ref-ls: '; learn ref ls 2>/dev/null | head -1 | grep . || echo MISSING
	printf 'learn-levels: '; _n=0; for _f in /usr/share/learn/levels/*; do [ -e "$_f" ] && _n=$((_n+1)); done; echo "$_n"
	printf 'learn-pools: '; _n=0; for _f in /usr/share/learn/pools/*; do [ -e "$_f" ] && _n=$((_n+1)); done; echo "$_n"
	# phrases drives the question-wording variety; without it prompts render with
	# a literal %show% in them. prove one actually expands in the booted image.
	printf 'learn-phrases: '; [ -f /usr/share/learn/phrases ] && echo yes || echo "no (BAD)"
	# grep -c prints its count AND exits nonzero on no match, so no `|| echo`.
	printf 'learn-varies: '; a=$(learn 1 </dev/null 2>/dev/null | grep -c '%[a-z][a-z]*%'); [ "${a:-1}" = 0 ] && echo yes || echo "no (BAD -- unexpanded macro)"
	# the challenge track must hold its shape on the machine, not only at build
	printf 'learn-chains: '; learn challenge check >/dev/null 2>&1 && echo yes || echo "no (BAD)"
	# print presence, never addresses -- this output gets read aloud
	printf 'net-iface-up: '; ip -o -4 addr show scope global 2>/dev/null | awk '{print $2}' | head -1 | grep . || echo none
	printf 'net-has-address: '; [ "$(ip -o -4 addr show scope global 2>/dev/null | wc -l)" -gt 0 ] && echo yes || echo no
	printf 'net-default-route: '; ip route show default 2>/dev/null | grep -oq 'dev' && echo yes || echo no
	printf 'net-dns-servers: '; _c=$(grep -c nameserver /tmp/resolv.conf 2>/dev/null); echo "${_c:-0}"
	# print the mac itself only here: the block is xos.test-gated (G31 keeps
	# the flag off production) and a per-boot random mac identifies nothing.
	_up=$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $2}' | head -1)
	printf 'mac-uplink: '; cat "/sys/class/net/${_up:-none}/address" 2>/dev/null || echo none
	printf 'mac-randomized: '
	if grep -q xos.realmac /proc/cmdline; then echo "off (xos.realmac)"
	elif [ -n "$_up" ] && [ -s "/tmp/mac.$_up" ] && [ "$(cat "/tmp/mac.$_up")" != "$(cat "/sys/class/net/$_up/address")" ]; then echo yes
	else echo "no (BAD)"; fi
	# ii ships and is build-tested (compiled + manifest-checked), but its
	# runtime probes were gated on xos.irc, a flag nothing ever sets -- wiring
	# a full irc server into the qemu harness is heavy for what it buys, so
	# the dead probe block that used to live here is gone. no runtime coverage
	# for ii; build-tested only.

	printf 'HEAD / HTTP/1.0\r\nHost: letsencrypt.org\r\nConnection: close\r\n\r\n' | timeout 20 tlstunnel - letsencrypt.org 443 > /tmp/tls.out 2> /tmp/tls.err
	printf 'tls-handshake: '; head -1 /tmp/tls.out 2>/dev/null | tr -d '\r' | grep . || echo FAILED
	printf 'tls-stderr: '; head -1 /tmp/tls.err 2>/dev/null | grep . || echo none
	printf 'trust-anchors-in-binary: '; _c=$(grep -ac 'Internet Security Research Group' /bin/tlstunnel 2>/dev/null); echo "${_c:-0}"

	printf 'writable-home: '; touch "$HOME/probe" 2>/dev/null && echo "yes (tmpfs)" || echo no
	# persistence across reboots, driven non-interactively. the harness attaches
	# a blank second virtio disk (/dev/vdb) and boots twice. boot 1 finds it
	# blank and provisions it -- LUKS2 + integrity, an ext2 filesystem, a marker.
	# boot 2 finds it already LUKS, opens it, and reads the marker back: proof
	# the bytes survived a real power cycle. the open+mount path is identical to
	# the interactive one; only the passphrase source differs.
	if grep -q xos.teststate /proc/cmdline && [ -b /dev/vdb ]; then
		if cryptsetup isLuks /dev/vdb 2>/dev/null; then
			printf 'teststate-phase: reopen\n'
			printf 'teststate-open: '
			if printf 'testpass' | cryptsetup open --key-file - /dev/vdb ts >/dev/null 2>&1; then
				echo ok
				mkdir -p /tmp/ts
				mount -t ext4 -o nosuid,nodev,noexec /dev/mapper/ts /tmp/ts 2>/dev/null
				printf 'teststate-prior-marker: '; [ -f /tmp/ts/marker ] && cat /tmp/ts/marker || echo NONE
				recon_check /tmp/ts
				umount /tmp/ts 2>/dev/null; cryptsetup close ts 2>/dev/null
			else echo FAILED; fi
		else
			printf 'teststate-phase: provision\n'
			printf 'teststate-format: '
			if printf 'testpass' | cryptsetup luksFormat --type luks2 --integrity hmac-sha256 \
			     --pbkdf pbkdf2 --pbkdf-force-iterations 1000 --batch-mode --key-file - /dev/vdb >/dev/null 2>&1
			then echo ok; else echo FAILED; fi
			printf 'teststate-mkfs: '
			if printf 'testpass' | cryptsetup open --key-file - /dev/vdb ts >/dev/null 2>&1; then
				if mke2fs -F /dev/mapper/ts >/dev/null 2>&1; then echo ok; else echo FAILED; fi
				mkdir -p /tmp/ts
				mount -t ext4 -o nosuid,nodev,noexec /dev/mapper/ts /tmp/ts 2>/dev/null
				printf 'teststate-write: '; if echo "survived-a-reboot" > /tmp/ts/marker; then sync; echo ok; else echo FAILED; fi
				recon_check /tmp/ts
				umount /tmp/ts 2>/dev/null; cryptsetup close ts 2>/dev/null
			else echo FAILED; fi
		fi
	fi

	# remote access: wireguard interface + dropbear over loopback. a full
	# two-machine handshake needs a second endpoint and is verified on real
	# hardware; here we prove every component works -- the interface comes up and
	# wg configures it, and dropbear accepts a real pubkey login end to end.
	if grep -q xos.testwg /proc/cmdline; then
		printf 'wg-iface-up: '
		if ip link add wg0 type wireguard 2>/dev/null; then
			wg genkey > /tmp/wgkey 2>/dev/null
			wg set wg0 private-key /tmp/wgkey listen-port 51820 2>/dev/null
			ip addr add 10.9.0.1/24 dev wg0 2>/dev/null
			ip link set wg0 up 2>/dev/null
			ip -o link show wg0 2>/dev/null | grep -q 'wg0' && echo ok || echo FAILED
		else echo "FAILED (no wireguard interface type)"; fi
		# wg show reports the configured interface: public key derived, port set.
		printf 'wg-show: '; wg show wg0 2>/dev/null | grep -qE 'public key|listening port' && echo ok || echo FAILED

		# dropbear over loopback with a real ed25519 key exchange
		dropbearkey -t ed25519 -f /tmp/hostkey >/dev/null 2>&1
		dropbearkey -t ed25519 -f /tmp/clientkey >/dev/null 2>&1
		mkdir -p /tmp/home/.ssh
		dropbearkey -y -f /tmp/clientkey 2>/dev/null | grep '^ssh-ed25519' > /tmp/home/.ssh/authorized_keys
		chmod 600 /tmp/home/.ssh/authorized_keys
		# -F: stay in the foreground so the backgrounded job IS the server and
		# $! is its real pid -- without it dropbear double-forks, $! captures the
		# parent that exits at once, and the later kill misses the live daemon.
		dropbear -r /tmp/hostkey -p 127.0.0.1:2222 -E -F >/tmp/db.log 2>&1 &
		_dbpid=$!
		sleep 1
		printf 'ssh-listening: '; netstat -ltn 2>/dev/null | grep -q '127.0.0.1:2222' && echo yes || echo no
		printf 'ssh-pubkey-login: '
		dbclient -y -i /tmp/clientkey -p 2222 root@127.0.0.1 'echo TUNNEL-SHELL-OK' 2>/dev/null \
			| grep -q 'TUNNEL-SHELL-OK' && echo ok || echo FAILED
		# a client whose key is NOT in authorized_keys must be rejected -- proves
		# auth is enforced, not open.
		printf 'ssh-wrong-key-refused: '
		dropbearkey -t ed25519 -f /tmp/badkey >/dev/null 2>&1
		if dbclient -y -i /tmp/badkey -p 2222 root@127.0.0.1 'echo SHOULD-NOT-RUN' 2>/dev/null | grep -q 'SHOULD-NOT-RUN'; then
			echo "ACCEPTED (BAD)"; else echo "refused (good)"; fi
		kill "$_dbpid" 2>/dev/null
		ip link del wg0 2>/dev/null
	fi

	[ -n "${_prevprintk:-}" ] && echo "$_prevprintk" > /proc/sys/kernel/printk 2>/dev/null
	echo "XOS-TEST-END"
	sync
fi

# tighten default permissions on anything the session writes to tmpfs
umask 077

# ── p3: encrypted + authenticated persistent state ──────────────────────────
#
# opt-in, and safe to decline. a missing partition, an empty passphrase, a
# timeout, a wrong passphrase, or xos.nostate all fall through to the ephemeral
# tmpfs home -- exactly the appliance xos was before p3 existed. nothing here
# can lose data it did not just unlock.
#
# the partition is found by LABEL, not device path, so it works whatever the
# host calls the stick. it is opened with the kernel crypto backend, and mounted
# nosuid,nodev,noexec: state persists, but a binary dropped onto it still cannot
# run -- the same W^X property the read-only root has.
#
# this runs AFTER the test block (which powers off) so an automated boot never
# blocks on the prompt, and BEFORE the consoles so the session that starts sees
# the persistent home.
STATE_DIR=/tmp/home
state_open() {
	grep -q xos.nostate /proc/cmdline && return 1
	command -v cryptsetup >/dev/null 2>&1 || return 1
	# find the state partition by its LUKS header, not by a label -- an
	# unopened LUKS container exposes no filesystem label, and this works
	# whatever the host names the stick (sda3, nvme0n1p3, vdb3). the host's
	# own disks never enumerate (no nvme/sata driver), so every partition
	# seen here is on the stick or on attached usb.
	local cands="" dev p
	for p in /sys/class/block/*/partition; do
		[ -f "$p" ] || continue
		local cand="/dev/$(basename "$(dirname "$p")")"
		[ -b "$cand" ] || continue
		cryptsetup isLuks "$cand" 2>/dev/null && cands="$cands $cand"
	done
	[ -n "$cands" ] || return 1

	local pass
	printf '\n  unlock persistent state? passphrase (empty to skip): ' > /dev/console
	if ! IFS= read -r -s -t 30 pass < /dev/console; then printf '\n' > /dev/console; return 1; fi
	printf '\n' > /dev/console
	[ -n "$pass" ] || return 1

	# try the passphrase against EVERY LUKS partition on the bus, not just the
	# first one found: an unrelated encrypted drive sharing the hub must not
	# shadow the real state stick and turn a correct passphrase into "wrong".
	local opened=""
	for dev in $cands; do
		if printf '%s' "$pass" | cryptsetup open --key-file - "$dev" xosstate >/dev/null 2>&1; then
			opened="$dev"; break
		fi
	done
	if [ -z "$opened" ]; then
		printf '  wrong passphrase -- continuing without persistence\n' > /dev/console
		return 1
	fi
	mkdir -p "$STATE_DIR"
	# mount p3 over /tmp/home -- the tmpfs home created earlier is shadowed by
	# the persistent one. explicit -t ext4 because busybox mount does not probe
	# the type (the ext4 driver mounts ext2/3/4 alike), and the mountpoint is
	# under /tmp because the root is read-only.
	if ! mount -t ext4 -o nosuid,nodev,noexec /dev/mapper/xosstate "$STATE_DIR" 2>/dev/null; then
		cryptsetup close xosstate 2>/dev/null
		return 1
	fi
	return 0
}

if state_open; then
	# $HOME is already /tmp/home, now backed by the encrypted partition. recreate
	# the xdg dirs on it; everything written here -- learn progress included --
	# survives a reboot.
	mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_STATE_HOME"
	printf '  state unlocked -- %s persists across reboots\n' "$HOME" > /dev/console
	recon_check "$STATE_DIR"

	# ── remote access ───────────────────────────────────────────────────────
	# activates only when p3 is unlocked AND a wireguard config is present on it.
	# the config's presence IS the opt-in -- it lives on the encrypted partition,
	# so an attacker holding the stick cannot see it, let alone turn it on. no
	# cmdline flag, nothing to toggle on the untrusted host.
	#
	# xos dials OUT: wg brings up the tunnel to a peer you control, and dropbear
	# binds ONLY to the wireguard address, so xos never opens a port on the
	# network it is plugged into. the host key lives on p3 (a key in the
	# reproducible image would be a published private key); titan's public key is
	# in authorized_keys, baked into the read-only root where verity covers it.
	if [ -f "$STATE_DIR/wg0.conf" ] && command -v wg >/dev/null 2>&1; then
		# keep the prefix length the operator wrote (WireGuard point-to-point is
		# conventionally /32); only default to /24 when the conf gives none.
		wgip=$(sed -n 's/^ *Address *= *\([0-9./]*\).*/\1/p' "$STATE_DIR/wg0.conf" | head -1)
		case "$wgip" in */*) : ;; ?*) wgip="$wgip/24" ;; esac
		if ip link add wg0 type wireguard 2>/dev/null \
		   && wg setconf wg0 "$STATE_DIR/wg0.conf" 2>/dev/null \
		   && [ -n "$wgip" ] \
		   && ip addr add "$wgip" dev wg0 2>/dev/null \
		   && ip link set wg0 up 2>/dev/null; then
			printf '  wireguard up on wg0 (%s)\n' "$wgip" > /dev/console
			# host key on p3, made once
			[ -f "$STATE_DIR/ssh_host_key" ] || dropbearkey -t ed25519 -f "$STATE_DIR/ssh_host_key" >/dev/null 2>&1
			# authorized_keys: prefer the one baked into the image (verity-covered),
			# fall back to one on p3 if the operator put it there.
			akeys=/etc/dropbear/authorized_keys
			[ -f "$STATE_DIR/authorized_keys" ] && akeys="$STATE_DIR/authorized_keys"
			if [ -f "$akeys" ]; then
				mkdir -p "$HOME/.ssh"; cp "$akeys" "$HOME/.ssh/authorized_keys"; chmod 600 "$HOME/.ssh/authorized_keys"
				dropbear -r "$STATE_DIR/ssh_host_key" -p "$wgip:22" >/dev/null 2>&1 &
				printf '  ssh listening on the tunnel only (%s:22), pubkey only\n' "$wgip" > /dev/console
			else
				printf '  no authorized_keys -- ssh not started (add one to enable)\n' > /dev/console
			fi
		else
			printf '  wireguard config present but wg0 did not come up\n' > /dev/console
			ip link del wg0 2>/dev/null
		fi
	fi
fi

banner() {
	cat <<'BANNER'

  xos -- static-pie musl, read-only root
  every byte on this disk is covered by a hash tree

BANNER
	[ -n "$fpw" ] && printf '  this image is: %s\n\n' "$fpw"
}

# ── consoles ────────────────────────────────────────────────────────────────
#
# PID 1 used to end `exec /bin/sh`, which made PID 1 *be* the session. two
# consequences: the shell had no controlling terminal, so job control was off
# ("can't access tty"), and when it exited the kernel panicked. PID 1 is now a
# supervisor that owns nothing and outlives every console.
#
# each console is a respawn loop. setsid gives the shell its own session and
# cttyhack makes the terminal its controlling one -- that pair is what makes
# ^C, ^Z, fg and bg work.
console_loop() {
	# separate statements on purpose: `_dev=$1 _fail=0 _t0` would set _dev and
	# _fail only in the environment of the command `_t0`, leaving them UNSET in
	# the function -- which wrote the banner to an empty path and spun forever.
	# this ran on every real boot and no test caught it, because test boots
	# power off before the console is ever set up. the console-health probe
	# below now exercises this path.
	_dev=$1; _fail=0
	# health beacon (bounded -- single line, overwritten): proves this loop is
	# running with a real device, which the empty-$_dev bug made impossible.
	[ -n "$_dev" ] && printf '%s\n' "$_dev" > /tmp/console.up 2>/dev/null
	while : ; do
		_t0=$(date +%s 2>/dev/null || echo 0)
		banner > "$_dev" 2>/dev/null
		# $_dev is a tty, not a regular file: rx+tx on one line is the point, not a hazard
		# shellcheck disable=SC2094
		setsid cttyhack /bin/sh <>"$_dev" >"$_dev" 2>&1 \
			|| /bin/sh <>"$_dev" >"$_dev" 2>&1
		# a console nothing is attached to returns EOF instantly and would
		# respawn forever. this machine may be passive-cooled; back off instead.
		if [ "$(( $(date +%s 2>/dev/null || echo 0) - _t0 ))" -lt 2 ]; then
			_fail=$((_fail + 1))
		else
			_fail=0
		fi
		if [ "$_fail" -ge 5 ]; then sleep 30; else sleep 1; fi
	done
}

# how many virtual terminals to open. 6 is the convention every linux ships,
# and 12 is the ceiling: past Alt+F12 there is no key to reach them and this
# build has no chvt.
ttys=$(sed -n 's/.*xos\.ttys=\([0-9][0-9]*\).*/\1/p' /proc/cmdline)
[ -n "$ttys" ] || ttys=6
[ "$ttys" -ge 1 ] 2>/dev/null || ttys=6
[ "$ttys" -le 12 ] 2>/dev/null || ttys=12

# real hardware: every virtual terminal gets its own shell, so Alt+F1..F6
# switches between running sessions. under qemu -nographic the fbcon exists but
# is unseen, so these run harmlessly in the background there.
spawned=0
if [ -d /sys/class/graphics/fbcon ]; then
	n=1
	while [ "$n" -le "$ttys" ]; do
		if [ -c "/dev/tty$n" ]; then
			console_loop "/dev/tty$n" &
			spawned=$((spawned + 1))
		fi
		n=$((n + 1))
	done
fi

# the serial/primary console gets a supervised session too, so losing the line
# no longer takes PID 1 down with it.
console_loop /dev/console &

if grep -q xos.test /proc/cmdline; then
	# the console loops set a health beacon when they start with a real device.
	# with the old empty-$_dev bug it was never written.
	printf 'console-device-ok: '; [ -s /tmp/console.up ] && echo yes || echo "no (BAD)"
	echo "ttys-spawned: $spawned"
	echo "XOS-TEST-DONE"
	sync
	# PID 1 no longer exits, so a test boot would otherwise run until the
	# harness timeout on every single section. end it deliberately instead --
	# and only ever on a cmdline flag that lives inside the signed UKI.
	# xos.testtether: A18 owns that boot's lifetime -- the tether (or the
	# harness timeout) ends it, never this block.
	if ! grep -q xos.testtether /proc/cmdline; then
		poweroff -f
	fi
fi

# PID 1 must never exit -- an exit here is a kernel panic. wait returns as each
# child is reaped; the sleep matters because wait with NO children returns
# immediately, which would spin a core on a passive-cooled machine.
while : ; do
	wait
	sleep 1
done
