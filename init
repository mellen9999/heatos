#!/bin/sh
# nosuid,nodev,noexec everywhere they are safe. /dev keeps device nodes (no
# nodev) but drops suid+exec. these close the one W^X hole in an otherwise
# immutable system: a static-pie binary needs no loader, so a writable+
# executable tmpfs was a place to drop and run code. noexec /tmp shuts it.
mount -t proc  -o nosuid,nodev,noexec none /proc
mount -t sysfs -o nosuid,nodev,noexec none /sys
mount -t devtmpfs -o nosuid,noexec none /dev 2>/dev/null
# securityfs exposes /sys/kernel/security/lockdown so the lockdown state is
# provable at runtime (the test block reads it; A8 asserts it).
mount -t securityfs -o nosuid,nodev,noexec none /sys/kernel/security 2>/dev/null

# ptys. devtmpfs does not create /dev/pts, and without it openpty() fails --
# which means no multiplexer and no ssh session can allocate a terminal. nothing
# in the image used a pty until now, which is why this was missing and nothing
# noticed. ptmxmode=666 so an unprivileged process could open it the day
# anything here stops running as root.
mkdir -p /dev/pts
mount -t devpts -o nosuid,noexec,gid=5,mode=620,ptmxmode=666 none /dev/pts 2>/dev/null

# the root is read-only by design, so anything that needs to write gets a
# RAM-backed home. nothing here survives a reboot, which is the point.
mount -t tmpfs -o nosuid,nodev,noexec none /tmp

# runtime sysctl hardening. write /proc/sys directly (no sysctl-applet dep).
# a key whose feature is compiled out is simply absent -- that is already the
# safe state, so skip it; a write that FAILS on a present key is loud. several
# (dmesg_restrict, perf_event_paranoid) are inert while the console is root,
# and are set for the day that stops being true.
for kv in \
  kernel/kptr_restrict=2 \
  kernel/dmesg_restrict=1 \
  kernel/perf_event_paranoid=3 \
  fs/protected_symlinks=1 \
  fs/protected_hardlinks=1 \
  fs/protected_fifos=2 \
  fs/protected_regular=2 \
  net/ipv4/tcp_syncookies=1 \
  net/ipv4/conf/all/accept_redirects=0 \
  net/ipv4/conf/all/send_redirects=0 \
  net/ipv4/conf/all/accept_source_route=0 \
  net/ipv4/conf/all/rp_filter=1 \
  net/ipv4/icmp_echo_ignore_broadcasts=1
do
  p=/proc/sys/${kv%=*}; v=${kv#*=}
  [ -e "$p" ] || continue
  echo "$v" > "$p" 2>/dev/null || echo "sysctl FAILED: ${kv%=*}"
done
mkdir -p /tmp/home
export HOME=/tmp/home
export XDG_DATA_HOME=/tmp/home/.local/share
export XDG_CONFIG_HOME=/tmp/home/.config
export XDG_STATE_HOME=/tmp/home/.local/state
export TERM=linux
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_STATE_HOME"

ip link set lo up 2>/dev/null
if ! grep -q vos.nonet /proc/cmdline; then
	for dev in $(ls /sys/class/net 2>/dev/null); do
		[ "$dev" = lo ] && continue
		ip link set "$dev" up 2>/dev/null
		udhcpc -i "$dev" -q -t 3 -T 1 >/dev/null 2>&1 && break
	done
fi

if grep -q vos.test /proc/cmdline; then
	echo
	echo "VOS-TEST-BEGIN"
	printf 'rootfs-type: '; awk '$2=="/" {print $3}' /proc/mounts
	printf 'rootfs-flags: '; awk '$2=="/" {print $4}' /proc/mounts
	printf 'write-to-root: '; if touch /probe 2>/dev/null; then echo "SUCCEEDED (BAD)"; else echo "refused (good)"; fi
	printf 'dynamic-loader-present: '; if [ -e /lib/ld-musl-x86_64.so.1 ]; then echo "yes (BAD)"; else echo "no (good)"; fi
	printf 'module-loader: '; if [ -e /proc/modules ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	# kernel attack-surface + containment probes (A8/A9 grep these)
	printf 'devmem-node: '; if [ -e /dev/mem ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	printf 'devport-node: '; if [ -e /dev/port ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	printf 'kcore: '; if [ -e /proc/kcore ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	printf 'kexec-loaded: '; if [ -e /sys/kernel/kexec_loaded ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	printf 'vsyscall-map: '; grep -c vsyscall /proc/self/maps 2>/dev/null || echo 0
	printf 'lockdown: '; cat /sys/kernel/security/lockdown 2>/dev/null || echo "(no securityfs)"
	printf 'remount-rw: '; if mount -o remount,rw / 2>/dev/null; then echo "SUCCEEDED (BAD)"; else echo "refused (good)"; fi
	printf 'tmp-exec: '; cp /bin/busybox /tmp/probe-x 2>/dev/null; chmod +x /tmp/probe-x 2>/dev/null; if /tmp/probe-x true 2>/dev/null; then echo "SUCCEEDED (BAD)"; else echo "refused (good)"; fi; rm -f /tmp/probe-x
	printf 'kptr-restrict: '; cat /proc/sys/kernel/kptr_restrict 2>/dev/null || echo '?'
	printf 'dmesg-restrict: '; cat /proc/sys/kernel/dmesg_restrict 2>/dev/null || echo '?'
	printf 'busybox-runs: '; busybox true && echo yes || echo no
	printf 'no-bash: '; if [ -e /bin/bash ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	# a pty is the thing every multiplexer and every ssh session needs. prove one
	# can actually be allocated, not merely that the config claims to allow it.
	printf 'devpts-mounted: '; awk '$2=="/dev/pts" {print $3; f=1} END{if(!f) print "no"}' /proc/mounts
	printf 'ptmx-node: '; if [ -c /dev/ptmx ]; then echo yes; else echo "no (BAD)"; fi
	printf 'pty-alloc: '; if exec 9<>/dev/ptmx 2>/dev/null; then
		ls /dev/pts 2>/dev/null | grep -q '^[0-9]' && echo ok || echo "FAILED (no slave)"
		exec 9>&-
	else echo "FAILED (no ptmx)"; fi
	printf 'legacy-ptys: '; if [ -c /dev/ptyp0 ]; then echo "present (BAD)"; else echo "absent (good)"; fi
	printf 'abduco-runs: '; abduco 2>&1 | head -1 | grep -q 'Active sessions' && echo yes || echo no
	# the property that matters is not "abduco starts" but "the program outlives
	# the thing that started it". start a counter detached, wait, and read the
	# session back: if the session is still listed, nothing owned it but abduco.
	abduco -n probe /bin/sh -c 'i=0; while [ $i -lt 20 ]; do echo $i > /tmp/tick; i=$((i+1)); sleep 1; done' >/dev/null 2>&1
	sleep 3
	printf 'abduco-session-listed: '; abduco 2>&1 | grep -q probe && echo yes || echo no
	printf 'abduco-child-alive: '; [ -s /tmp/tick ] && echo yes || echo no
	# learn must describe the system that is actually running, not the one it was
	# written against -- A15 reads these two back.
	printf 'learn-refs: '; ls /usr/share/learn/ref 2>/dev/null | grep -c . || echo 0
	printf 'learn-runs: '; learn list 2>/dev/null | grep -c . || echo 0
	printf 'learn-ref-ls: '; learn ref ls 2>/dev/null | head -1 | grep . || echo MISSING
	printf 'learn-levels: '; ls /usr/share/learn/levels 2>/dev/null | grep -c . || echo 0
	printf 'learn-pools: '; ls /usr/share/learn/pools 2>/dev/null | grep -c . || echo 0
	# print presence, never addresses -- this output gets read aloud
	printf 'net-iface-up: '; ip -o -4 addr show scope global 2>/dev/null | awk '{print $2}' | head -1 | grep . || echo none
	printf 'net-has-address: '; [ "$(ip -o -4 addr show scope global 2>/dev/null | wc -l)" -gt 0 ] && echo yes || echo no
	printf 'net-default-route: '; ip route show default 2>/dev/null | grep -oq 'dev' && echo yes || echo no
	printf 'net-dns-servers: '; grep -c nameserver /tmp/resolv.conf 2>/dev/null || echo 0
	irc=$(sed -n 's/.*vos\.irc=\([^ ]*\).*/\1/p' /proc/cmdline)
	if [ -n "$irc" ]; then
		ihost=${irc%:*}; iport=${irc##*:}
		mkdir -p "$HOME/irc"
		ii -s "$ihost" -p "$iport" -n vos -f vos -i "$HOME/irc" > /tmp/ii.log 2>&1 &
		sleep 3
		printf 'ii-stderr: '; head -2 /tmp/ii.log 2>/dev/null | tr '\n' ' '; echo
		printf 'ii-home: '; echo "$HOME"; ls -d "$HOME/irc" 2>/dev/null || echo '  (no irc dir)'
		d=$(find "$HOME/irc" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | head -1)
		printf 'ii-created-tree: '; [ -n "$d" ] && echo yes || echo no
		printf 'ii-server-greeting: '; grep -c 'Welcome to the vos test network' "$d/out" 2>/dev/null || echo 0
		printf 'ii-in-fifo: '; [ -p "$d/in" ] && echo yes || echo no
		echo '/j #vos' > "$d/in" 2>/dev/null
		sleep 2
		printf 'ii-joined-channel: '; find "$HOME/irc" -maxdepth 2 -type d -name '#vos' 2>/dev/null | wc -l
	fi

	echo 0 > /proc/sys/kernel/printk
	printf 'HEAD / HTTP/1.0\r\nHost: letsencrypt.org\r\nConnection: close\r\n\r\n' | tlstunnel - letsencrypt.org 443 > /tmp/tls.out 2> /tmp/tls.err
	printf 'tls-handshake: '; head -1 /tmp/tls.out 2>/dev/null | tr -d '\r' | grep . || echo FAILED
	printf 'tls-stderr: '; head -1 /tmp/tls.err 2>/dev/null | grep . || echo none
	echo 1 > /proc/sys/kernel/printk
	printf 'trust-anchors-in-binary: '; grep -ac 'Internet Security Research Group' /bin/tlstunnel 2>/dev/null || echo 0

	printf 'writable-home: '; touch "$HOME/probe" 2>/dev/null && echo "yes (tmpfs)" || echo no
	echo "VOS-TEST-END"
	sync
fi

# tighten default permissions on anything the session writes to tmpfs
umask 077

banner() {
	cat <<'BANNER'

  vos -- static-pie musl, read-only root
  every byte on this disk is covered by a hash tree

BANNER
}

# ── consoles ────────────────────────────────────────────────────────────────
#
# PID 1 used to end `exec /bin/sh`, which made PID 1 *be* the session. two
# consequences: the shell had no controlling terminal, so job control was off
# ("can't access tty"), and when it exited the kernel panicked. PID 1 is now a
# supervisor that owns nothing and outlives every console.
#
# each console is a respawn loop. setsid gives the shell its own session and
# cttyhack makes the terminal its controlling one -- that pair is what makes
# ^C, ^Z, fg and bg work.
console_loop() {
	_dev=$1 _fail=0 _t0
	while : ; do
		_t0=$(date +%s 2>/dev/null || echo 0)
		banner > "$_dev" 2>/dev/null
		setsid cttyhack /bin/sh <>"$_dev" >"$_dev" 2>&1 \
			|| /bin/sh <>"$_dev" >"$_dev" 2>&1
		# a console nothing is attached to returns EOF instantly and would
		# respawn forever. this machine may be passive-cooled; back off instead.
		if [ "$(( $(date +%s 2>/dev/null || echo 0) - _t0 ))" -lt 2 ]; then
			_fail=$((_fail + 1))
		else
			_fail=0
		fi
		if [ "$_fail" -ge 5 ]; then sleep 30; else sleep 1; fi
	done
}

# how many virtual terminals to open. 6 is the convention every linux ships,
# and 12 is the ceiling: past Alt+F12 there is no key to reach them and this
# build has no chvt.
ttys=$(sed -n 's/.*vos\.ttys=\([0-9][0-9]*\).*/\1/p' /proc/cmdline)
[ -n "$ttys" ] || ttys=6
[ "$ttys" -ge 1 ] 2>/dev/null || ttys=6
[ "$ttys" -le 12 ] 2>/dev/null || ttys=12

# real hardware: every virtual terminal gets its own shell, so Alt+F1..F6
# switches between running sessions. under qemu -nographic the fbcon exists but
# is unseen, so these run harmlessly in the background there.
spawned=0
if [ -d /sys/class/graphics/fbcon ]; then
	n=1
	while [ "$n" -le "$ttys" ]; do
		if [ -c "/dev/tty$n" ]; then
			console_loop "/dev/tty$n" &
			spawned=$((spawned + 1))
		fi
		n=$((n + 1))
	done
fi

# the serial/primary console gets a supervised session too, so losing the line
# no longer takes PID 1 down with it.
console_loop /dev/console &

if grep -q vos.test /proc/cmdline; then
	echo "ttys-spawned: $spawned"
	echo "VOS-TEST-DONE"
	sync
	# PID 1 no longer exits, so a test boot would otherwise run until the
	# harness timeout on every single section. end it deliberately instead --
	# and only ever on a cmdline flag that lives inside the signed UKI.
	poweroff -f
fi

# PID 1 must never exit -- an exit here is a kernel panic. wait returns as each
# child is reaped; the sleep matters because wait with NO children returns
# immediately, which would spin a core on a passive-cooled machine.
while : ; do
	wait
	sleep 1
done
