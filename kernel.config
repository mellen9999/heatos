CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_INIT=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_LIB_SHA256=y
CONFIG_BLK_DEV=y
CONFIG_BLOCK=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_CRYPTO=y
CONFIG_VIRTIO_MENU=y
CONFIG_DM_BUFIO=y
CONFIG_ZLIB_INFLATE=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_RELOCATABLE=y
CONFIG_ACPI=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y

# --- real hardware: usb-stick boot ---------------------------------------
# the stick enumerates on xHCI (any secure-boot-capable machine is xHCI-era);
# EHCI/OHCI/UHCI are deliberately absent -- pre-xHCI boxes are out of scope.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# NO NVMe, NO AHCI/SATA on purpose: a kernel that cannot see the internal disk
# cannot touch it. "your disks are untouched" is enforced by absent drivers.

# --- real hardware: keyboard + visible console ---------------------------
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
# efifb, not simpledrm: simpledrm drags in the whole DRM core (~1 MiB). efifb
# claims the efi-framebuffer platform device sysfb registers. do NOT set
# SYSFB_SIMPLEFB -- it would hand that device to simplefb and efifb gets none.
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y

# --- kernel self-protection ----------------------------------------------
# tinyconfig leaves ALL of these off. the worst offender: CPU_MITIGATIONS=n
# compiled out every spectre/meltdown mitigation. these turn them on and are
# gated (G14) so a config regression fails the build, not just weakens it.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_X86_UMIP=y
CONFIG_PANIC_ON_OOPS=y
# already on via tinyconfig -- pinned so a future defconfig drift fails loud
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y

# --- lockdown LSM (compiled-in confidentiality, > any cmdline knob) -------
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y

# --- assert-OFF: attack surface that must never come back -----------------
# the build fails if any of these is =y. most are already off under tinyconfig;
# pinning them makes a future config change that re-enables them a build error.
CONFIG_MODULES=n
CONFIG_SLUB_TINY=n
CONFIG_SLAB_MERGE_DEFAULT=n
CONFIG_X86_VSYSCALL_EMULATION=n
CONFIG_LEGACY_TIOCSTI=n
CONFIG_X86_IOPL_IOPERM=n
CONFIG_X86_MPPARSE=n
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=n
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n
CONFIG_IO_URING=n
CONFIG_BPF_SYSCALL=n
CONFIG_DEBUG_FS=n
CONFIG_PROC_KCORE=n
CONFIG_PROC_VMCORE=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=n
CONFIG_IA32_EMULATION=n
CONFIG_USERFAULTFD=n
CONFIG_MODIFY_LDT_SYSCALL=n
CONFIG_COREDUMP=n
CONFIG_E1000=n

# ptys. these were already on -- but only because olddefconfig put them there,
# which means G14 was not defending them and a config change could have dropped
# them silently. every multiplexer and every ssh session needs a pty, so pin the
# one we use and turn off the obsolete interface we do not.
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n
