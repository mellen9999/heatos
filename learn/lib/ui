# ui -- terminal output. square, dense, ANSI-256, no motion.
#
# colour is a courtesy, never information: every state that colour marks is
# also marked by a character, so NO_COLOR and a dumb terminal lose nothing.

if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ] || [ ! -t 1 ]; then
	N= B= D= R= G= Y= C= M= W= U= V=
else
	N=$(printf '\033[0m')      B=$(printf '\033[1m')    D=$(printf '\033[2m')
	R=$(printf '\033[38;5;196m') G=$(printf '\033[38;5;46m')
	Y=$(printf '\033[38;5;226m') C=$(printf '\033[38;5;51m')
	M=$(printf '\033[38;5;208m') W=$(printf '\033[38;5;231m')
	U=$(printf '\033[4m')     V=$(printf '\033[7m')
fi

# terminal width. ash does not export COLUMNS the way bash does, so trusting it
# alone pinned every session to 80 and made the rules wrap on any other size.
# ask the terminal itself, then fall back.
# synchronised output: the editor reprints the whole answer line on every
# keystroke, which can tear or flicker on a slow or remote terminal. wrapping a
# redraw in these markers tells the terminal to paint it in one frame. unknown
# to older terminals, which ignore the private mode -- so it is safe everywhere.
if [ "${TERM:-dumb}" = dumb ] || [ ! -t 1 ]; then
	SYNC_BEG= SYNC_END=
else
	SYNC_BEG=$(printf '\033[?2026h') SYNC_END=$(printf '\033[?2026l')
fi

COLS=${COLUMNS:-}
[ -n "$COLS" ] || COLS=$(stty size 2>/dev/null | cut -d' ' -f2)
[ -n "$COLS" ] || COLS=$(tput cols 2>/dev/null)
[ "$COLS" -ge 40 ] 2>/dev/null || COLS=80
# never draw past 100 columns -- a full-width rule on an ultrawide terminal is
# noise, not structure.
[ "$COLS" -le 100 ] 2>/dev/null || COLS=100

rule() { printf '%s' "$D"; awk -v n="$COLS" 'BEGIN{while(n-->0)printf "-"}'; printf '%s\n' "$N"; }

# the answer prompt, cmdchamp-style: a bare $ at the far left, white while you
# type and red the moment you drop to vi normal mode. built here where the R/W
# colour globals are in scope -- inside the editor R is the right-of-cursor
# buffer, so it cannot see them.
PROMPT_INS=$(printf '%s$ %s' "$W" "$N")
PROMPT_NORM=$(printf '%s$ %s' "$R" "$N")

hdr() {
	printf '\n%s%s%s %s\n' "$B$M" "$1" "$N" "${D}$2$N"
	rule
}

# say -- prose, wrapped to the terminal, never past 76 columns. blank lines
# stay blank: indenting them left trailing-whitespace lines all through the text.
say() { fold -s -w $(( COLS < 78 ? COLS - 2 : 76 )) | sed '/./s/^/  /'; }

ok()   { printf '  %s+%s %s\n' "$G" "$N" "$1"; }
no()   { printf '  %s-%s %s\n' "$R" "$N" "$1"; }
note() { printf '  %s%s%s\n' "$D" "$1" "$N"; }

# the answer a miss or a skip reveals, shown the way you would have typed it:
# a dim $ at the far left, the command in yellow -- the same shape as the live
# prompt, so the eye reads it as "this is what belonged on that line".
reveal() { printf '%s$ %s%s%s%s\n' "$D" "$N" "$Y" "$1" "$N"; }
