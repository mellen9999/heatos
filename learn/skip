ash -i
ash -l
ash -s
ash -u
ash -x

# ── flags whose feature this build or this machine does not have ──
mount -a        # mounts everything in fstab; vos has no fstab
umount -d       # frees a loop device on unmount; paired with losetup, not taught
umount -r       # remount read-only if the unmount fails
umount -t       # filter by filesystem type, only useful with -a
fdisk -b        # sector size override
fdisk -C        # cylinder count override -- geometry, obsolete on anything modern
fdisk -H
fdisk -S
fdisk -u        # sectors rather than cylinders; already the default
setsid -c       # set the controlling terminal; cttyhack is what vos uses
sync -f         # sync the filesystem holding a file; -d covers the idea
tee -i          # ignore interrupts
wget -Y         # proxy on/off
xargs -o        # reopen stdin as /dev/tty, for interactive children
xargs -x        # exit if the size limit is exceeded; -s sets it
vi -c           # run an ex command on open
vi -H           # list vi's own build options
top -H          # per-thread view; ps -T covers threads
top -m          # memory-order display; the sort keys cover it
free -g         # gigabytes; -h picks the unit for you
cut -F          # awk-style field splitting; awk is the tool for that
du -H           # follow symlinks named on the command line
du -L           # follow every symlink
strings -f      # prefix each line with the filename, only useful over many files
arp -p          # dump the raw arp table format
flock -u        # drop a lock held by an earlier command in the same script

