echo -e         # enable escapes; printf is the tool that does this properly
gzip -t         # test integrity; gunzip -t is the spelling taught
bzip2 -f
bzip2 -k
bzip2 -t
bunzip2 -f
bunzip2 -k
gunzip -f
gunzip -k
tar -a          # pick compression by file extension
tar -h          # follow symlinks when creating
